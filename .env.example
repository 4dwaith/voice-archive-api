# Compose configuration. Copy to .env; the application reads only process variables.
# These are development defaults, not deployment credentials.
VOICE_ARCHIVE_POSTGRES_USER=voice_archive
VOICE_ARCHIVE_POSTGRES_PASSWORD=voice_archive
VOICE_ARCHIVE_POSTGRES_DB=voice_archive
VOICE_ARCHIVE_POSTGRES_PORT=5432
API_PORT=8000
VOICE_ARCHIVE_TEST_POSTGRES_USER=voice_archive_test
VOICE_ARCHIVE_TEST_POSTGRES_PASSWORD=voice_archive_test
VOICE_ARCHIVE_TEST_POSTGRES_PORT=5433

VOICE_ARCHIVE_ENVIRONMENT=development
# Generate a random secret of at least 32 characters to enable sign-in.
# VOICE_ARCHIVE_AUTH_SECRET=
# HTTPS is the default. Set false only for local HTTP development.
VOICE_ARCHIVE_AUTH_COOKIE_SECURE=true
VOICE_ARCHIVE_AUTH_TOKEN_TTL_SECONDS=43200
# For host-side PyCharm/uv. Docker Compose supplies its own database hostname.
# Compose uses the database settings above with its internal db hostname.
VOICE_ARCHIVE_UPLOAD_ROOT=./uploads
VOICE_ARCHIVE_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","https://localhost:5173","https://127.0.0.1:5173"]'
# Optional total multipart request cap, including form overhead. Unset/null disables this extra cap.
# VOICE_ARCHIVE_UPLOAD_MAX_BYTES=null
# Maximum incoming cover file size: 25 MiB.
VOICE_ARCHIVE_COVER_MAX_BYTES=26214400
# Maximum incoming source PDF size: 1.5 GB. Configurable above this value.
VOICE_ARCHIVE_PDF_MAX_BYTES=1500000000
# Maximum incoming chapter MP3 size: 1.5 GB.
VOICE_ARCHIVE_AUDIO_MAX_BYTES=1500000000

VOICE_ARCHIVE_POSTGRES_HOST=127.0.0.1

# Server-only Gemini credential for Live and book questions. Live reports unavailable until configured.
VOICE_ARCHIVE_GEMINI_API_KEY=
# Optional server-only credential for summary generation and its cache calls.
# Falls back to VOICE_ARCHIVE_GEMINI_API_KEY when unset or empty.
VOICE_ARCHIVE_GEMINI_BATCH_API_KEY=
VOICE_ARCHIVE_GEMINI_LIVE_MODEL=gemini-3.8-live
VOICE_ARCHIVE_GEMINI_TEXT_MODEL=gemini-3.8-flash
# Planned window embeddings; changing these takes effect on the next window rebuild.
VOICE_ARCHIVE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
VOICE_ARCHIVE_GEMINI_EMBEDDING_DIMENSIONS=768
VOICE_ARCHIVE_EMBEDDING_INPUT_FORMAT=retrieval-document-v1
VOICE_ARCHIVE_EMBEDDING_SUBMISSION_GRACE_SECONDS=900
VOICE_ARCHIVE_EMBEDDING_COLLECTION_INTERVAL_SECONDS=180
VOICE_ARCHIVE_EMBEDDING_BATCH_TOKENS=150000
VOICE_ARCHIVE_EMBEDDING_MAX_ATTEMPTS=3
VOICE_ARCHIVE_GEMINI_ANSWER_INPUT_TOKENS=1000000
VOICE_ARCHIVE_GEMINI_ANSWER_TIMEOUT_SECONDS=150

# Optional external reranker; deployment and GPU model hosting are managed separately.
VOICE_ARCHIVE_RERANKER_BASE_URL=null
VOICE_ARCHIVE_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
VOICE_ARCHIVE_RERANKER_TIMEOUT_SECONDS=60
VOICE_ARCHIVE_RERANKER_MAX_INPUT_TOKENS=4096
